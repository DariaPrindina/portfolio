\pard\intbl\itap1\sl280\sb60\sa60{\fs24 Frontend Developer Intern\par}

\pard\intbl\itap1\sl260\sa60{\fs18 \uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1072  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1093  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1092 \uc0\u1077 \uc0\u1081 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1074  \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1082 \uc0\u1072 \uc0\u1093  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1078 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1082 .{\line}\uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1074  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1072 \uc0\u1093  3\uc0\u8211 6 \uc0\u1095 \uc0\u1077 \uc0\u1083 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1082  \uc0\u1087 \uc0\u1086  Agile-\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1091  (\uc0\u1089 \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1099 , code review){\line}{\line}- \uc0\u1056 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1072 \uc0\u1090 \uc0\u1099 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1072  UI-\uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1086 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1099  \uc0\u1080  \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1094 \uc0\u1099  \uc0\u1085 \uc0\u1072  React, Vue 3 \uc0\u1080  React Native{\line}- \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1089  \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1084 \uc0\u1080 , \uc0\u1090 \uc0\u1072 \uc0\u1073 \uc0\u1083 \uc0\u1080 \uc0\u1094 \uc0\u1072 \uc0\u1084 \uc0\u1080 , \uc0\u1084 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1084 \uc0\u1080  \uc0\u1086 \uc0\u1082 \uc0\u1085 \uc0\u1072 \uc0\u1084 \uc0\u1080 {\line}- \uc0\u1048 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1075 \uc0\u1088 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1072  REST API (Axios){\line}- \uc0\u1053 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1084 \uc0\u1072 \uc0\u1088 \uc0\u1096 \uc0\u1088 \uc0\u1091 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1102  \uc0\u1080  \uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1089 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1103 \uc0\u1085 \uc0\u1080 \uc0\u1077 \uc0\u1084  (Redux Toolkit, Pinia){\line}- \uc0\u1056 \uc0\u1077 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1089 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1103 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1079 \uc0\u1072 \uc0\u1075 \uc0\u1088 \uc0\u1091 \uc0\u1079 \uc0\u1082 \uc0\u1080  \uc0\u1080  \uc0\u1086 \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1080  \uc0\u1086 \uc0\u1096 \uc0\u1080 \uc0\u1073 \uc0\u1086 \uc0\u1082 {\line}- \uc0\u1059 \uc0\u1095 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1074  \uc0\u1088 \uc0\u1077 \uc0\u1092 \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1085 \uc0\u1075 \uc0\u1077  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1086 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1091 \uc0\u1083 \uc0\u1091 \uc0\u1095 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1080  \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1091 \uc0\u1088 \uc0\u1099  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1072 {\line}- \uc0\u1048 \uc0\u1089 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1103 \uc0\u1083 \uc0\u1072  UI-\uc0\u1073 \uc0\u1072 \uc0\u1075 \uc0\u1080  \uc0\u1080  \uc0\u1091 \uc0\u1083 \uc0\u1091 \uc0\u1095 \uc0\u1096 \uc0\u1072 \uc0\u1083 \uc0\u1072  \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1087 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 {\line}{\line}\uc0\u1057 \uc0\u1090 \uc0\u1077 \uc0\u1082 : React, TypeScript, Vue 3, React Native, Redux Toolkit, Pinia, Axios, SCSS.}

\cell\row

